From 96d986dccded0086c615e7df35db0fbf90c59be4 Mon Sep 17 00:00:00 2001
From: John <326213404+jedeyesniv-art@users.noreply.github.com>
Date: Wed, 21 Oct 2026 20:18:26 +0100
Subject: [PATCH 8/9] Graphics: optional app draw filter
 (SetDrawRegisterFilter)

Called before every draw with the active shaders' ucode hashes and the
register file; it may return temporary register writes (e.g. a shader
constant) that apply to that draw only and are restored right after it,
through the normal WriteRegister path so backends track them. Stored in
rexruntime so the app and the GPU plugin share it.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 include/rex/graphics/draw_filter.h | 31 ++++++++++++++++++++++++++++++
 src/graphics/command_processor.cpp | 24 +++++++++++++++++++++++
 src/system/gpu_plugin_loader.cpp   | 20 +++++++++++++++++++
 3 files changed, 75 insertions(+)
 create mode 100644 include/rex/graphics/draw_filter.h

diff --git a/include/rex/graphics/draw_filter.h b/include/rex/graphics/draw_filter.h
new file mode 100644
index 0000000..fba235b
--- /dev/null
+++ b/include/rex/graphics/draw_filter.h
@@ -0,0 +1,31 @@
+/**
+ * Optional app hook into the GPU plugin's draws (e.g. to recolour one element of a game's UI).
+ */
+
+#pragma once
+
+#include <cstdint>
+
+namespace rex::graphics {
+
+// What the command processor knows about a draw when it asks the filter.
+struct DrawFilterInfo {
+  uint64_t vertex_shader_hash;  // ucode data hash of the active shaders, 0 if none
+  uint64_t pixel_shader_hash;
+  const uint32_t* registers;  // the whole register file (read only)
+};
+
+struct DrawRegisterWrite {
+  uint32_t index;
+  uint32_t value;
+};
+
+// Called before every draw. May fill up to max_writes register writes (e.g. a shader constant) and return how many;
+// they are applied through the normal register write path for this draw only and restored right after it.
+using DrawRegisterFilter = uint32_t (*)(const DrawFilterInfo& info, DrawRegisterWrite* writes, uint32_t max_writes);
+
+// Kept in rexruntime so the app and the GPU plugin share it. One filter at a time; nullptr removes it.
+void SetDrawRegisterFilter(DrawRegisterFilter filter);
+DrawRegisterFilter GetDrawRegisterFilter();
+
+}  // namespace rex::graphics
diff --git a/src/graphics/command_processor.cpp b/src/graphics/command_processor.cpp
index 12d3aa4..cf0a741 100644
--- a/src/graphics/command_processor.cpp
+++ b/src/graphics/command_processor.cpp
@@ -22,6 +22,8 @@
 #include <rex/perf/counter.h>
 #include <rex/chrono/clock.h>
 #include <rex/graphics/command_processor.h>
+#include <rex/graphics/draw_filter.h>
+#include <rex/graphics/pipeline/shader/shader.h>
 #include <rex/graphics/flags.h>
 #include <rex/graphics/graphics_system.h>
 #include <rex/graphics/pipeline/texture/info.h>
@@ -1418,8 +1420,30 @@ bool CommandProcessor::ExecutePacketType3Draw(memory::RingBuffer* reader, uint32
 
       bool major_mode_explicit =
           xenos::IsMajorModeExplicit(vgt_draw_initiator.major_mode, vgt_draw_initiator.prim_type);
+      // App draw filter: temporary register writes for this draw only (see draw_filter.h).
+      constexpr uint32_t kMaxFilterWrites = 8;
+      DrawRegisterWrite filter_writes[kMaxFilterWrites];
+      uint32_t filter_saved[kMaxFilterWrites];
+      uint32_t filter_count = 0;
+      if (DrawRegisterFilter filter = GetDrawRegisterFilter()) {
+        const DrawFilterInfo info{
+            active_vertex_shader_ ? active_vertex_shader_->ucode_data_hash() : 0,
+            active_pixel_shader_ ? active_pixel_shader_->ucode_data_hash() : 0, register_file_->values};
+        filter_count = std::min(filter(info, filter_writes, kMaxFilterWrites), kMaxFilterWrites);
+        for (uint32_t i = 0; i < filter_count; ++i) {
+          if (filter_writes[i].index >= RegisterFile::kRegisterCount) {
+            filter_count = i;
+            break;
+          }
+          filter_saved[i] = register_file_->values[filter_writes[i].index];
+          WriteRegister(filter_writes[i].index, filter_writes[i].value);
+        }
+      }
       draw_succeeded = IssueDraw(vgt_draw_initiator.prim_type, vgt_draw_initiator.num_indices,
                                  is_indexed ? &index_buffer_info : nullptr, major_mode_explicit);
+      for (uint32_t i = filter_count; i-- > 0;) {
+        WriteRegister(filter_writes[i].index, filter_saved[i]);
+      }
       if (!draw_succeeded) {
         auto vgt_output_path_cntl = register_file_->Get<reg::VGT_OUTPUT_PATH_CNTL>();
         auto vgt_hos_cntl = register_file_->Get<reg::VGT_HOS_CNTL>();
diff --git a/src/system/gpu_plugin_loader.cpp b/src/system/gpu_plugin_loader.cpp
index 754fa13..d7f91ba 100644
--- a/src/system/gpu_plugin_loader.cpp
+++ b/src/system/gpu_plugin_loader.cpp
@@ -11,6 +11,8 @@
 
 #include <rex/system/gpu_plugin.h>
 
+#include <atomic>
+
 #include <filesystem>
 #include <string>
 #include <vector>
@@ -103,3 +105,21 @@ std::unique_ptr<IGraphicsSystem> LoadGpuPlugin(std::string_view name, std::strin
 }
 
 }  // namespace rex::system
+
+#include <rex/graphics/draw_filter.h>
+
+namespace rex::graphics {
+
+namespace {
+std::atomic<DrawRegisterFilter> g_draw_register_filter{nullptr};
+}  // namespace
+
+void SetDrawRegisterFilter(DrawRegisterFilter filter) {
+  g_draw_register_filter.store(filter, std::memory_order_release);
+}
+
+DrawRegisterFilter GetDrawRegisterFilter() {
+  return g_draw_register_filter.load(std::memory_order_acquire);
+}
+
+}  // namespace rex::graphics
