From 81d10cccfbedf64d584924ef04871badf3312d9c Mon Sep 17 00:00:00 2001
From: John <326213404+jedeyesniv-art@users.noreply.github.com>
Date: Wed, 21 Oct 2026 20:37:30 +0100
Subject: [PATCH 9/9] Runtime: game data can be a package file (STFS)

When game_data_root is a file instead of a folder, it is mounted as an STFS
package (LIVE / CON / PIRS, e.g. an XBLA title as dumped from the console),
read-only, at the same place. ReXApp accepts a file there and leaves the
entrypoint check to LoadXexImage, since the XEX is inside the package.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/system/runtime.cpp | 17 ++++++++++++-----
 src/ui/rex_app.cpp     |  9 ++++++---
 2 files changed, 18 insertions(+), 8 deletions(-)

diff --git a/src/system/runtime.cpp b/src/system/runtime.cpp
index c10694c..5a40992 100644
--- a/src/system/runtime.cpp
+++ b/src/system/runtime.cpp
@@ -13,6 +13,7 @@
 #include <rex/cvar.h>
 #include <rex/filesystem/devices/host_path_device.h>
 #include <rex/filesystem/devices/null_device.h>
+#include <rex/filesystem/devices/stfs_container_device.h>
 #include <rex/filesystem/vfs.h>
 #include <rex/logging.h>
 #include <rex/perf/counter.h>
@@ -303,16 +304,22 @@ bool Runtime::SetupVfs() {
     return false;
   }
 
-  // Mount game_data_root as \Device\Harddisk0\Partition1
+  // Mount game_data_root as \Device\Harddisk0\Partition1: a folder of game files, or a game package file
+  // (STFS: LIVE / CON / PIRS, e.g. an XBLA title as stored on the console), which is mounted read-only.
   auto mount_path = "\\Device\\Harddisk0\\Partition1";
-  auto device = std::make_unique<rex::filesystem::HostPathDevice>(
-      mount_path, abs_game_root, !REXCVAR_GET(allow_game_relative_writes));
+  std::unique_ptr<rex::filesystem::Device> device;
+  if (std::filesystem::is_regular_file(abs_game_root)) {
+    device = std::make_unique<rex::filesystem::StfsContainerDevice>(mount_path, abs_game_root);
+  } else {
+    device = std::make_unique<rex::filesystem::HostPathDevice>(
+        mount_path, abs_game_root, !REXCVAR_GET(allow_game_relative_writes));
+  }
   if (!device->Initialize()) {
-    REXSYS_ERROR("Runtime::SetupVfs: Failed to initialize host path device");
+    REXSYS_ERROR("Runtime::SetupVfs: Failed to initialize the game data device for {}", abs_game_root.string());
     return false;
   }
   if (!file_system_->RegisterDevice(std::move(device))) {
-    REXSYS_ERROR("Runtime::SetupVfs: Failed to register host path device");
+    REXSYS_ERROR("Runtime::SetupVfs: Failed to register the game data device");
     return false;
   }
   REXSYS_DEBUG("  Mounted {} at {}", abs_game_root.string(), mount_path);
diff --git a/src/ui/rex_app.cpp b/src/ui/rex_app.cpp
index 9ff54e8..9ff76ae 100644
--- a/src/ui/rex_app.cpp
+++ b/src/ui/rex_app.cpp
@@ -205,7 +205,9 @@ bool ReXApp::ConstructRuntime(const PathConfig& paths) {
     rex::ShowSimpleMessageBox(rex::SimpleMessageBoxType::Error, msg);
     return false;
   }
-  if (!std::filesystem::is_directory(paths.game_data_root)) {
+  // A folder of game files, or a game package file (STFS, mounted by Runtime::SetupVfs).
+  const bool game_package = std::filesystem::is_regular_file(paths.game_data_root);
+  if (!game_package && !std::filesystem::is_directory(paths.game_data_root)) {
     auto msg = fmt::format("--game_data_root does not exist: {}", paths.game_data_root.string());
     REXLOG_ERROR("{}", msg);
     rex::ShowSimpleMessageBox(rex::SimpleMessageBoxType::Error, msg);
@@ -260,8 +262,9 @@ bool ReXApp::ConstructRuntime(const PathConfig& paths) {
   std::string xex_image = "game:\\default.xex";
   OnLoadXexImage(xex_image);
 
-  // Mirrors the game:\ / d:\ -> game_data_root mapping in Runtime::SetupVfs.
-  {
+  // Mirrors the game:\ / d:\ -> game_data_root mapping in Runtime::SetupVfs. (Inside a package the XEX can't be
+  // checked on disk; LoadXexImage reports it missing instead.)
+  if (!game_package) {
     constexpr std::string_view kGameDevice = "game:\\";
     constexpr std::string_view kDDevice = "d:\\";
     std::string_view tail = xex_image;
-- 
