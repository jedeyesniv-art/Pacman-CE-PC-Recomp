# Game data from your own console - never commit or share
private/

# Generated C++ from XenonRecomp - can be recreated any time from the config
ppc/

# Generated C++ from ReXGlue codegen (game code) - recreated by the build
rexglue/generated/default/
rexglue/out/

# XenonRecomp is its own Git repository (cloned from GitHub)
tools/xenonRecomp/

# ReXGlue SDK (prebuilt nightly, downloaded)
tools/rexglue-sdk/
tools/rexglue-sdk-dl/

# Build outputs (dist\ is the portable folder and may hold a copy of the game files)
build/
dist/
*.exe
*.obj
*.pdb

# Logs and inspection dumps (contain disassembly of the game's code)
*.txt
!CMakeLists.txt
!rexglue/README-portable.txt
!rexglue/licenses/*.txt

# Python caches
__pycache__/
tools/XeXtool/
*.xex
